{
  "name": "penplot-studio-desktop",
  "productName": "PenPlot Studio",
  "version": "1.0.0",
  "private": true,
  "description": "PenPlot Studio desktop app (Electron wrapper around the static web app)",
  "author": "joshuamontierth",
  "license": "UNLICENSED",
  "main": "main.js",
  "desktopName": "penplot-studio.desktop",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "stage": "node prepare.mjs",
    "start": "node start.mjs",
    "pack": "node prepare.mjs && electron-builder --dir --publish never",
    "dist": "node prepare.mjs && electron-builder --publish never",
    "dist:linux": "node prepare.mjs && electron-builder --linux --publish never",
    "dist:win": "node prepare.mjs && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.joshuamontierth.penplotstudio",
    "productName": "PenPlot Studio",
    "copyright": "Copyright (c) 2026 joshuamontierth",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "synopsis": "Pen-plotter G-code generator",
      "executableName": "penplot-studio",
      "syncDesktopName": true,
      "artifactName": "PenPlot-Studio-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "PenPlot-Studio-${version}-win-${arch}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PenPlot-Studio-Setup-${version}-win-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
