{
  "name": "penplot-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Pen-plotter G-code generator for the Bambu Lab X1 Carbon (static, no-build web app)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs --live",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "cross-env FUZZ_N=3 vitest run --coverage",
    "test:fuzz": "cross-env FUZZ_N=2000 vitest run test/unit/fuzz.test.js",
    "test:e2e": "playwright test",
    "test:e2e:full": "cross-env FUZZ_N=200 playwright test e2e/browser-suite.spec.js",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:e2e",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.2",
    "cross-env": "10.1.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
